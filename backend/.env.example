PORT=5000
# Local MongoDB or paste your Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/bloodbank
# Set to true to run with a temporary in-memory database (no MongoDB install needed)
USE_MEMORY_DB=false
# Admin login (change these!). SESSION_SECRET signs login tokens; set a long random value.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=change-me-to-a-long-random-string
